# Copied over main.tf's real `provider "aws"` block by scripts/run-team.sh
# so `terraform plan` never makes a real AWS API call or needs real
# credentials. Safe because this module's only data sources
# (aws_iam_policy_document) are computed locally, never fetched from AWS.
provider "aws" {
  region = "eu-west-1"

  access_key                  = "demo"
  secret_key                  = "demo"
  skip_credentials_validation = true
  skip_requesting_account_id  = true
  skip_metadata_api_check     = true

  default_tags {
    tags = {
      managed-by = "terraform"
      platform   = "self-service-aws"
    }
  }
}
